# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Network: Arc mainnet (chain 5042) ---
# This project targets Arc mainnet. Testnet works too, but change all four
# values below together -- the explorer is ignored unless
# ARC_EXPLORER_CHAIN_ID matches the chain the RPC actually serves.

# Arc RPC endpoint (EVM-compatible)
#   mainnet: https://rpc.mainnet.arc.io   (chain 5042)
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Chain ID of the RPC above. Also sent to GoPlus for the address check.
ARC_CHAIN_ID=5042

# Arc's block explorer exposes an Etherscan-compatible API, but mainnet's
# explorer.arc.io serves /api behind a Cloudflare bot challenge, so a
# server-side client gets an HTML challenge page rather than JSON. Real API
# access has to come from Arc/Circle. Leave both blank until you have it:
# contract age then reads "could not verify" rather than being silently
# wrong, and an unlimited approval tops out at MEDIUM instead of HIGH.
#
# Addresses collide across chains, so an explorer indexing a different chain
# can report a creation date belonging to a different contract -- making a
# brand-new scam contract look established. That is the one failure here that
# would fail open, hence the chain-id check in explorer_available().
ARC_EXPLORER_API_BASE=
ARC_EXPLORER_CHAIN_ID=
ARC_EXPLORER_API_KEY=

# --- Plain-language explanation layer (swappable -- see backend/llm.py) ---

# Which provider writes the explanation:
#   anthropic | groq | grok | gemini | openai
# (groq = api.groq.com, open models; grok = xAI -- different services)
#
# This is what selects the provider -- setting a key alone does nothing. If
# LLM_PROVIDER is unset it defaults to anthropic, so a deployment holding
# only a GROQ_API_KEY still starts with no provider and degrades to
# rule-based wording. Set both, together.
LLM_PROVIDER=groq

# Optional -- leave blank to use that provider's default model.
LLM_MODEL=

# Only the key for the provider selected above needs a value.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
