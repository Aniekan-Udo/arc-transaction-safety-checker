# Copy this file to .env and fill in real values. Never commit .env itself.

# Arc RPC endpoint (EVM-compatible -- e.g. from Circle, Alchemy, dRPC, etc)
#   mainnet: https://rpc.mainnet.arc.io   (chain 5042)
#   testnet: https://rpc.testnet.arc.io   (chain 5042002)
ARC_RPC_URL=

# Chain ID of the RPC above. Also sent to GoPlus for the address check.
ARC_CHAIN_ID=5042

# Arc's block explorer exposes an Etherscan-compatible API. Testnet is open
# (https://explorer.testnet.arc.io -- Blockscout); mainnet's explorer.arc.io
# serves /api behind a Cloudflare bot challenge, so a server-side client gets
# an HTML challenge page rather than JSON. You need real API access from
# Arc/Circle, not just the hostname. Either form works here, with or without
# a trailing /api.
# Leave blank if you don't have access: contract age then reads as
# "could not verify" rather than being silently wrong.
ARC_EXPLORER_API_BASE=

# Which chain the explorer indexes. MUST match the RPC's chain, or the
# explorer is ignored. Addresses collide across chains, so a testnet explorer
# answering about a mainnet address can report a creation date belonging to a
# different contract -- making a brand-new scam contract look established.
# That is the one failure here that would fail open, hence the check.
ARC_EXPLORER_CHAIN_ID=

ARC_EXPLORER_API_KEY=

# --- Plain-language explanation layer (swappable -- see backend/llm.py) ---

# Which provider writes the explanation:
#   anthropic | groq | grok | gemini | openai
# (groq = api.groq.com, open models; grok = xAI -- different services)
LLM_PROVIDER=anthropic

# Optional -- leave blank to use that provider's default model.
LLM_MODEL=

# Only the key for the provider selected above needs a value.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
